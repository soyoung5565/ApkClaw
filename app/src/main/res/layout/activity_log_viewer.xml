<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBgSecondary"
    android:orientation="vertical">

    <com.apk.claw.android.widget.CommonToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56pt" />

    <!-- 录制状态栏 -->
    <LinearLayout
        android:id="@+id/recordingBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1AFF0000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16pt"
        android:paddingVertical="8pt"
        android:visibility="gone">

        <View
            android:id="@+id/recordingDot"
            android:layout_width="10pt"
            android:layout_height="10pt"
            android:background="@drawable/bg_red_dot" />

        <TextView
            android:id="@+id/tvRecordingStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8pt"
            android:text="Recording..."
            android:textColor="#FF0000"
            android:textSize="13pt"
            android:textStyle="bold" />

        <com.apk.claw.android.widget.KButton
            android:id="@+id/btnStopRecording"
            android:layout_width="wrap_content"
            android:layout_height="36pt"
            android:paddingHorizontal="16pt"
            android:text="Stop"
            android:textSize="13pt" />
    </LinearLayout>

    <!-- 操作按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16pt"
        android:paddingTop="8pt"
        android:paddingBottom="4pt">

        <com.apk.claw.android.widget.KButton
            android:id="@+id/btnStartRecording"
            android:layout_width="0dp"
            android:layout_height="40pt"
            android:layout_weight="1"
            android:layout_marginEnd="6pt"
            android:text="@string/log_recorder_start"
            android:textSize="13pt" />

        <com.apk.claw.android.widget.KButton
            android:id="@+id/btnShare"
            android:layout_width="0dp"
            android:layout_height="40pt"
            android:layout_weight="1"
            android:layout_marginHorizontal="3pt"
            android:text="@string/log_viewer_share"
            android:textSize="13pt" />

        <com.apk.claw.android.widget.KButton
            android:id="@+id/btnClear"
            android:layout_width="0dp"
            android:layout_height="40pt"
            android:layout_weight="1"
            android:layout_marginStart="6pt"
            android:text="@string/log_viewer_clear"
            android:textSize="13pt" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvLogCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20pt"
        android:paddingBottom="4pt"
        android:textColor="@color/colorTextSecondary"
        android:textSize="12pt" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvLogs"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingHorizontal="12pt"
        android:paddingBottom="16pt" />

    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="@string/log_viewer_empty"
        android:textColor="@color/colorTextTertiary"
        android:textSize="15pt"
        android:visibility="gone" />

</LinearLayout>
